# Application Title shown in browser tab and UI
VITE_APP_TITLE=Sharp Volta (Mattermost)

# API & WebSocket target for development proxy
VITE_PROXY_TARGET=http://localhost:3000
VITE_WS_TARGET=ws://localhost:3000/ws

# Optional: Custom Mattermost Server Base URL
# If omitted, automatically detected from the active desktop session cookie
# MATTERMOST_URL=https://mattermost.example.com

# Optional: Host filter if multiple Mattermost accounts exist in the cookies database
# MATTERMOST_HOST_FILTER=%example.com%

# Optional: Custom port for the server (defaults to 3000 with automatic port fallback)
# PORT=3000

# Optional: Mattermost Keychain Safe Storage password (macOS Keychain auto-read by default)
# MATTERMOST_KEYCHAIN_PASSWORD=
